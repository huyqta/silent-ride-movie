{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "silent-ride",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "silent-ride-next-cache"
		},
		{
			"bucket_name": "silent-ride-next-cache",
			"binding": "silent_ride_next_cache"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "silent-ride"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DOQueueHandler"
			]
		}
	]
}